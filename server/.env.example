# Copy this file to .env and fill in the values.

NODE_ENV=development
PORT=5000

# MongoDB Atlas (free tier) connection string. Atlas runs as a replica set,
# which payment transactions need. Local alternative:
#   mongodb://127.0.0.1:27017/lms?replicaSet=rs0  (single-node replica set)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lms?retryWrites=true&w=majority

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=1d

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:3000

# Salary slip storage
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# debug | info | warn | error
LOG_LEVEL=info
