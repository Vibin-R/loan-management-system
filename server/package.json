{
  "name": "lms-server",
  "version": "1.0.0",
  "private": true,
  "description": "Loan Management System API (Express + TypeScript + MongoDB)",
  "main": "dist/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\"",
    "seed": "tsx src/scripts/seed.ts",
    "test:e2e": "node tests/e2e.mjs"
  },
  "dependencies": {
    "bcryptjs": "3.0.2",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "express-rate-limit": "7.5.1",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.24.5",
    "multer": "2.4.0",
    "pino": "9.7.0",
    "pino-http": "10.5.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.0.0",
    "@types/node": "22.15.30",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.3.0",
    "pino-pretty": "13.0.0",
    "prettier": "3.6.2",
    "tsx": "4.20.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
